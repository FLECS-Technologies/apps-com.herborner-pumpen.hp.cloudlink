{
    "$schema": "https://git.flecs.tech/flecs/app-manifest/raw/branch/3.3.0/manifest.schema.json",
    "_schemaVersion": "3.3.0",
    "_minimumFlecsVersion": "5.6.0",
    "app": "com.herborner-pumpen.hp.cloudlink",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.herborner-pumpen.hp.cloudlink",
    "multiInstance": false,
    "editors": [{  "name": "CloudLink WebUI",  "port": 9330,  "supportsReverseProxy": true}],
    "capabilities": [
        "NET_ADMIN"
    ],
    "devices": [
        "/dev/net/tun"
    ],
    "env":[
        "LOGLEVEL=notice"
    ],
    "volumes":[
        "data:/app/data"
    ],
  "credential": {
    "type": "certificate"
  },
  "permissions": {
    "api": {
      "tech.flecs.core": {
        "read_instance_config": {},
        "write_instance_config": {},
        "read_system": {},
        "manage_instances": {},
        "jobs": {},
        "manage_apps": {},
        "manage_exports": {},
        "read_apps": {},
        "read_instances": {},
        "read_license_info": {},
        "sideload_app": {},
        "console_logout": {},
        "console_login": {},
        "read_networks": {},
        "create_network": {},
        "reserve_ipv4": {},
        "activate_license": {},
        "read_license_status": {},
        "start_device_onboarding": {},
        "list_exports": {},
        "download_export": {},
        "read_instance_logs": {},
        "read_manifests": {},
        "read_providers": {},
        "set_default_provider": {},
        "remove_default_provider": {}
      },
      "tech.flecs.fence": {
        "list_clients": {}
      }
    }
  }
}
 
